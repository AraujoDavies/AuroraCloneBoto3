# Copy to terraform.tfvars and fill in secrets:
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "us-east-1"

prod_cluster_identifier = "prod-aurora"
dev_cluster_identifier  = "dev-aurora"
# Defaults match .env.example TEMP_IDENTIFIER / OLD_IDENTIFIER
# temp_cluster_identifier = "temp-aurora"
# old_cluster_identifier  = "olddev-aurora"

master_username = "labadmin"
prod_master_password = "CHANGE-ME-prod-password"
dev_master_password  = "CHANGE-ME-dev-password"

# Prefer your public IP, e.g. "203.0.113.10/32"
allowed_cidr = "0.0.0.0/0"

# Optional Serverless v2 knobs (defaults are cheapest lab settings)
# min_capacity             = 0
# max_capacity             = 1
# seconds_until_auto_pause = 600
