# AWS credentials (local only; prefer IAM role in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# One identifier per role: same value for cluster + writer instance - setados no terraform lab (terraform.tfvars)
PROD_IDENTIFIER=prod-aurora
DEV_IDENTIFIER=dev-aurora
TEMP_IDENTIFIER=temp-aurora
OLD_IDENTIFIER=olddev-aurora

# Network / instance for TEMP clone — opcionais (default = cluster/writer DEV).
# Engine da writer TEMP vem sempre do cluster PROD (sem variável).
# DB_SUBNET_GROUP=default
# VPC_SECURITY_GROUP_IDS=sg-xxxxxxxx
# DB_INSTANCE_CLASS=db.serverless
# Opcional: força PubliclyAccessible na instância TEMP (writer).
# Omitir = mesmo valor do writer de DEV.
# DEV_PUBLICLY_ACCESSIBLE=true

# Credenciais de banco (MySQL ou PostgreSQL) — senha de DEV, não de PROD.
# Login = MasterUsername do cluster alvo (API RDS; make list-rds).
# Dump/login no DEV: master do DEV. TEMP (pós-clone): master da PROD.
# Porta/engine vêm do RDS (3306 MySQL / 5432 PostgreSQL).
# Dump: mydumper (MySQL) ou pg_dump -Fc (PostgreSQL).
# DB_PASSWORD: senha no env; se vazio, lê SecureString em DB_PASSWORD_SSM_PARAM.
# Após clone, o job seta MasterUserPassword do TEMP = DB_PASSWORD.
DB_PASSWORD=
# DB_PASSWORD_SSM_PARAM=/aurora-clone/dev/db_password
DB_PASSWORD_SSM_PARAM=
# Opcional (só PostgreSQL): database de conexão (default postgres).
# DB_NAME=postgres

# Sanitize TEMP (pós-clone, pré-dump) — opcional.
# Vazio/omitido: lista schemas (information_schema; MySQL e PostgreSQL) e segue.
# Preenchido: executa o .sql via mysql ou psql (ex. sanitize.example.sql /
# sanitize.example.pg.sql).
# SANITIZE_SQL_PATH=./sql/sanitize.example.sql
SANITIZE_SQL_PATH=

# Dump + validation
# DEV_SCHEMAS: opcional. Se vazio, auto = schemas(DEV) − schemas(TEMP)
# (TEMP precisa existir: make clone-prod-to-temp antes do dump).
# ATENÇÃO: lista fixa — schemas novos no DEV não entram no dump até atualizar.
# DEV_SCHEMAS=schema1,schema2
DUMP_BASE_DIR=./dumps
ROW_DIFF_TOLERANCE=50
WAIT_TIMEOUT_SECONDS=3600
# Game: a pasta YYYYMMDD_HHMMSS fica fixa por campanha em .aurora_game_checkpoint
# (campo run_dump_dir). Reabrir o game não cria outra pasta até resetar o progresso.

# Archive S3 (opcional) — só no fim de `make pipeline` / etapa ArchiveS3 do game.
# Se vazio: não sobe nada (etapa do game conclui como "pulado").
# Ordem: pipeline.log, depois dumps (mydumper ou *.dump do pg_dump) sob DUMP_BASE_DIR/YYYYMMDD_HHMMSS/.
# Ideal: bucket dedicado, Block Public Access, Lifecycle expire ~30 dias.
# S3_BUCKET=my-aurora-clone-archives
# S3_DUMP_PREFIX=aurora-clone/dev
S3_BUCKET=
S3_DUMP_PREFIX=
# Limpa pastas locais de dump com idade > N dias (default 15).
DUMP_LOCAL_RETENTION_DAYS=15

# If > 0, delete_old_dev only logs and skips delete
KEEP_OLD_DEV_HOURS=0

# Aurora Game — menu hack (simular erro / passar / voltar fase).
# Valores truthy: 1, true, yes, on. Omitir ou 0 = desligado.
# AURORA_GAME_HACK=1
